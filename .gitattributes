# Let Git normalize line endings automatically
* text=auto

# Files that run inside Linux containers MUST use LF (not Windows CRLF)
*.sh            text eol=lf
Dockerfile      text eol=lf
Makefile        text eol=lf
*.conf          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf

# Windows-only scripts keep CRLF
*.ps1           text eol=crlf
*.bat           text eol=crlf
*.cmd           text eol=crlf

# Binary files - never modify
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.webp          binary
*.pdf           binary
*.zip           binary
*.woff          binary
*.woff2         binary
*.ttf           binary
*.eot           binary